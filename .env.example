# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Nur serverseitig (Push + Erinnerungen). Niemals im Client verwenden!
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Web Push – erzeugen mit: npm run vapid
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:du@example.com

# Absicherung des Cron-Endpunkts (beliebiger langer Zufallswert)
CRON_SECRET=

# Öffentliche Adresse der App (für Links in Benachrichtigungen)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
